# Database connection (PostgreSQL in Docker)
DATABASE_URL="postgresql://nextbooking:nextbooking_secret@localhost:5432/nextbooking_cms?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="development-secret-change-in-production-123456789"

# Storage (local or s3)
STORAGE_PROVIDER="local"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin_secret"
S3_BUCKET_NAME="nextbooking-media"

# AI Translation
GEMINI_API_KEY=""

# Email (Resend or SendGrid)
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
